NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dailyfax
# Per Node process. Keep instances × limit under MySQL max_connections.
DB_CONNECTION_LIMIT=32
DB_QUEUE_LIMIT=1000
DB_CONNECT_TIMEOUT_MS=10000

# Per-IP request budget (raise for local load tests, e.g. 20000)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Cancel abandoned online orders and restore stock (minutes / interval)
UNPAID_ORDER_TTL_MINUTES=15
UNPAID_ORDER_RECLAIM_INTERVAL_MS=60000
UNPAID_ORDER_RECLAIM_ENABLED=true

JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_LENGTH=4
OTP_EXPIRES_SECONDS=300
OTP_DEV_CODE=1234
OTP_PROVIDER=dev

LOG_LEVEL=debug
CORS_ORIGIN=*
# Local admin SPA:
# CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Production example:
# CORS_ORIGIN=https://admin.dayfax.in,https://dayfax.in,https://www.dayfax.in

PUBLIC_BASE_URL=http://192.168.0.108:3000
# Production: PUBLIC_BASE_URL=https://backend.dayfax.in

# Razorpay (leave blank locally if unused — never commit real secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meilisearch (optional — leave blank to use MySQL synonym search fallback)
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_INDEX_PRODUCTS=products

# Admin console (email/password → admin_users table)
SEED_ADMIN_EMAIL=admin@dayfax.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=DayFax Admin

# Legacy optional: grant ADMIN role on app users phone (not used by admin SPA)
SEED_ADMIN_PHONE=
SEED_ADMIN_PHONE_COUNTRY_CODE=+91
