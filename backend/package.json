{
  "name": "dailyfax-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dailyfax quick-commerce REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p=require('path');const s='src/common/database/migrations';const d='dist/common/database/migrations';fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s)) if(f.endsWith('.sql')) fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "start": "node dist/server.js",
    "migrate": "tsx src/common/database/migrate.ts",
    "migrate:down": "tsx src/common/database/migrate.ts down",
    "seed": "tsx src/common/database/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "mysql2": "^3.24.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
